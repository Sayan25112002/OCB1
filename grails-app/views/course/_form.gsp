<div class="form-group">
    <label><g:message code="course.name"/></label>
    <g:textField name="courseName" value="${course?.courseName}" class="form-control" placeholder="Please Enter Course Name" required="required"/>
</div>

<div class="form-group">
    <label><g:message code="course.type"/></label>
    <g:textField name="courseType" value="${course?.courseType}" class="form-control" placeholder="Please Enter Course Type" required="required"/>
</div>